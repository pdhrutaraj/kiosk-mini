#include "mainwindow.h"

#include <QVBoxLayout>
#include <QPushButton>
#include <QPixmap>

MainWindow::MainWindow(QWidget* parent)
    : QMainWindow(parent)
{
    // MVC objects
    m_model = new BarcodeModel(this);
    m_generator = new BarcodeGenerator(this);
    m_scanner = new BarcodeScanner(m_model, this);

    // UI
    QWidget* central = new QWidget(this);
    setCentralWidget(central);

    auto* layout = new QVBoxLayout(central);

    m_imageLabel = new QLabel;
    m_imageLabel->setAlignment(Qt::AlignCenter);

    m_textLabel = new QLabel("Decoded text will appear here");
    m_textLabel->setAlignment(Qt::AlignCenter);

    auto* btn = new QPushButton("Generate QR");

    layout->addWidget(m_imageLabel);
    layout->addWidget(m_textLabel);
    layout->addWidget(btn);

    // Connections
    connect(btn, &QPushButton::clicked,
            this, &MainWindow::generateQR);

    connect(m_model, &BarcodeModel::barcodeUpdated,
            this, &MainWindow::onBarcodeUpdated);

    // Generate once on startup
    generateQR();
}

void MainWindow::generateQR()
{
    QImage qr = m_generator->generate("KIOSK-MINI-IMX93", 300);

    m_imageLabel->setPixmap(
        QPixmap::fromImage(qr).scaled(
            300, 300,
            Qt::KeepAspectRatio,
            Qt::SmoothTransformation));

    // Feed generated image to scanner (self-test)
    m_scanner->scanImage(qr);
}

void MainWindow::onBarcodeUpdated()
{
    m_textLabel->setText(m_model->text());
}
